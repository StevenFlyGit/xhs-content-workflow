{
  "name": "ottermind-vibecoding-website-template",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
